@Library('jenkins-library@feature/fww-158/ci-for-PRs')

def pipeline = new org.js.App2Pipeline(
    steps:                  this,
    buildDockerImage:       'electronuserland/builder:wine',
    dockerBuildRegistry:    'https://index.docker.io/v1/',
    dockerBuildRegistryCred: 'docker-hub-credentials',
    buildCmds:              ['yarn build:extension && yarn electron:build --publish=never --linux --mac zip && yarn electron:build --publish=never --win portable --x64 --ia32'],
    buildWithCred:          true,
    disableSecretScanner:   true
)
pipeline.runPipeline()  

