  booleanParam(defaultValue: true, description: '', name: 'tests'),
  booleanParam(defaultValue: true, description: 'Upload builds to nexus (master and develop branches upload always)', name: 'upload_to_nexus'),
]

def pipeline = new org.js.App2Pipeline(
    steps:                      this,
    dockerBuildRegistryDH:      'https://index.docker.io/v1/',
    dockerBuildRegistryCredDH:  'docker-hub-credentials',
    buildDockerImage:           'docker.soramitsu.co.jp/build-tools/node:14-ubuntu',
