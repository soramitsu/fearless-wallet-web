{
  "name": "fearless-wallet",
  "version": "1.0.0",
  "private": true,
  "author": {
    "email": "fearless.web@soramitsu.co.jp",
    "name": "Soramitsu",
    "url": "https://soramitsu.co.jp"
  },
  "description": "Non-Custodial and Decentralized wallet for the Polkadot and Kusama ecosystems with the best UX, performance and security.",
  "browserslist": "last 2 Chrome versions, last 2 Firefox versions",
  "scripts": {
    "serve": "env-cmd -f .env.desktop vue-cli-service serve",
    "build": "env-cmd -f .env.desktop vue-cli-service build",
    "build:extension": "EXTENSION_TYPE=chrome env-cmd -f .env.extension vue-cli-service build",
    "build:extension:firefox": "EXTENSION_TYPE=firefox env-cmd -f .env.extension vue-cli-service build",
    "build:extension:zip": "yarn run build:extension && cd dist/extension/chrome && zip -r fearless-wallet-extension-chrome.zip . && cd ../../../",
    "build:extension:firefox:zip": "yarn run build:extension:firefox && cd dist/extension/firefox && zip -r fearless-wallet-extension-firefox.zip . && cd ../../../",
    "build:extension:all": "yarn build:extension:zip && yarn build:extension:firefox:zip",
    "build-watch:extension": "EXTENSION_TYPE=chrome env-cmd -f .env.extension  vue-cli-service  --env.NODE_ENV=development build-watch --mode development",
    "build-watch:extension:firefox": "EXTENSION_TYPE=firefox env-cmd -f .env.extension vue-cli-service  --env.NODE_ENV=development build-watch --mode development",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "eslint --fix 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "lint:precommit": "NODE_ENV=production eslint --fix --quiet 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "electron:build": "env-cmd -f .env.desktop vue-cli-service electron:build",
    "electron:build-all": "env-cmd -f .env.desktop vue-cli-service electron:build --publish=never --linux --mac zip --win portable --x64",
    "electron:serve": "env-cmd -f .env.desktop vue-cli-service electron:serve",
    "test:all": "yarn test:unit",
    "audit:desktop": "npx electronegativity -i ./ -x LimitNavigationGlobalCheck,PermissionRequestHandlerGlobalCheck"
  },
  "main": "index.js",
  "dependencies": {
    "@airgap/beacon-sdk": "^3.3.3",
    "@equilab/api": "^1.13.1",
    "@polkadot/api": "^10.2.1",
    "@polkadot/extension-chains": "^0.44.6",
    "@polkadot/extension-dapp": "^0.44.6",
    "@polkadot/extension-inject": "^0.44.6",
    "@polkadot/phishing": "0.18.9",
    "@polkadot/rpc-provider": "10.1.3",
    "@polkadot/ui-keyring": "^2.9.6",
    "@polkadot/vue-identicon": "^2.9.8",
    "@sora-substrate/util": "1.15.7",
    "@soramitsu/soramitsu-js-ui": "^1.0.42",
    "@vespaiach/axios-fetch-adapter": "^0.3.1",
    "autoprefixer": "^10.4.13",
    "axios": "^0.27.2",
    "bignumber.js": "^9.0.2",
    "core-js": "^3.6.5",
    "date-fns": "^2.28.0",
    "element-ui": "^2.15.13",
    "ethers": "^5.7.2",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "qrcode": "^1.5.1",
    "rlp": "^3.0.0",
    "rxjs": "^7.5.6",
