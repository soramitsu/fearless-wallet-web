  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
