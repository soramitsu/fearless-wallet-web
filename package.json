{
  "name": "fearless-wallet",
  "version": "4.2.3",
  "private": true,
  "author": {
    "email": "fearless.web@soramitsu.co.jp",
    "name": "Soramitsu",
    "url": "https://soramitsu.co.jp"
  },
  "description": "Manage crypto accounts, view balances, and connect to compatible decentralized apps.",
  "browserslist": "last 2 Chrome versions, last 2 Firefox versions",
  "scripts": {
    "audit:dependencies": "yarn test:development-dependency-guards && yarn npm audit --all --recursive --severity low --no-deprecations",
    "audit:dependencies:production": "yarn npm audit --all --recursive --environment production --severity low --no-deprecations",
    "serve": "IS_EXTENSION=false env-cmd -f .env.web vite --config vite.config.web.ts --host 0.0.0.0",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint:check": "eslint 'src/**/*.{js,jsx,vue,ts,tsx}' 'tests/**/*.{js,jsx,ts,tsx}'",
    "lint": "eslint --fix 'src/**/*.{js,jsx,vue,ts,tsx}' 'tests/**/*.{js,jsx,ts,tsx}'",
    "build-watch:extension": "EXTENSION_TYPE=chrome OUTPUT_DIR=chrome IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --watch --mode development",
    "build-watch:extension:firefox": "EXTENSION_TYPE=firefox OUTPUT_DIR=firefox IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --watch --mode development",
    "build:extension": "VUE_APP_EXTENSION_SMOKE=false VUE_APP_TEST_ONLY=false EXTENSION_TYPE=chrome OUTPUT_DIR=chrome IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode production",
    "build:extension-test": "EXTENSION_TYPE=chrome VUE_APP_TEST_ONLY=true OUTPUT_DIR=chrome-test IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode development",
    "build:extension-test:zip": "yarn run build:extension-test && node scripts/package-extension.mjs --source dist/extension/chrome-test --output dist/extension/chrome-test/fearless-wallet-extension-chrome-test.zip",
    "build:extension:all": "yarn build:extension:zip && yarn build:extension-test:zip && yarn build:extension:firefox:zip",
    "build:extension:firefox": "yarn test:firefox-build-warning-policy && VUE_APP_EXTENSION_SMOKE=false VUE_APP_TEST_ONLY=false EXTENSION_TYPE=firefox OUTPUT_DIR=firefox IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode production",
    "build:extension:firefox-test": "EXTENSION_TYPE=firefox VUE_APP_TEST_ONLY=true OUTPUT_DIR=firefox-test IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode development",
    "build:extension:firefox:zip": "yarn run build:extension:firefox && node scripts/package-extension.mjs --source dist/extension/firefox --output dist/extension/firefox/fearless-wallet-extension-firefox.zip && yarn audit:bundle-hosts --dist dist/extension/firefox",
    "build:extension:zip": "yarn run build:extension && node scripts/package-extension.mjs --source dist/extension/chrome --output dist/extension/chrome/fearless-wallet-extension-chrome.zip && yarn audit:chrome-release",
    "build:web": "IS_EXTENSION=false env-cmd -f .env.web vite build --config vite.config.web.ts --mode production",
    "lint:webext:firefox": "node scripts/test-firefox-webext-warning-policy.mjs && node scripts/audit-firefox-webext-warnings.mjs",
    "lint:webext:firefox:raw": "web-ext lint --source-dir dist/extension/firefox --warnings-as-errors",
    "test:firefox-build-warning-policy": "node scripts/test-firefox-build-warning-policy.mjs",
    "test:firefox-smoke-policy": "node scripts/test-firefox-extension-smoke-policy.mjs",
    "test:ci-install-firefox": "bash scripts/ci-install-firefox.sh --self-test",
    "lint:precommit": "NODE_ENV=production eslint --fix --quiet 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "test:e2e:extension": "EXTENSION_TYPE=chrome VUE_APP_TEST_ONLY=true VUE_APP_EXTENSION_SMOKE=true OUTPUT_DIR=chrome-test IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode development && node scripts/solana-extension-smoke.mjs",
    "test:e2e:firefox": "yarn build:extension:firefox && yarn lint:webext:firefox && yarn test:smoke:firefox",
    "test:e2e:solana": "EXTENSION_TYPE=chrome VUE_APP_TEST_ONLY=true VUE_APP_EXTENSION_SMOKE=true OUTPUT_DIR=chrome-test IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode development && node scripts/solana-extension-smoke.mjs",
    "test:smoke:chrome:production": "node scripts/solana-extension-smoke.mjs --production-popup",
    "test:smoke:polkaswap": "node scripts/polkaswap-extension-smoke.mjs",
    "test:e2e:local-chains": "node scripts/test-local-chain-sends.mjs",
    "test:local-chain-processes": "node --test scripts/local-chains/test-process-lifecycle.mjs scripts/local-chains/test-bitcoind-rpc.mjs",
    "audit:key-exfiltration": "node scripts/audit-key-exfiltration.mjs",
    "test:key-exfiltration-audit": "node scripts/test-key-exfiltration-audit.mjs",
    "test:smoke:chrome:legacy-exposure": "node scripts/legacy-exposure-extension-smoke.mjs",
    "test:upgrade:build-legacy": "node scripts/upgrade-e2e/build-legacy.mjs",
    "test:upgrade:build-head": "node scripts/upgrade-e2e/build-head.mjs",
    "test:upgrade:e2e": "node scripts/upgrade-e2e/build-legacy.mjs && node scripts/upgrade-e2e/build-head.mjs && node scripts/upgrade-e2e/run.mjs",
    "test:upgrade:snapshot": "node scripts/upgrade-e2e/build-legacy.mjs && node scripts/upgrade-e2e/build-head.mjs && node scripts/upgrade-e2e/run.mjs --snapshot S1 S2 S3 S4 S5 S6 S7 S8",
    "audit:bundle-hosts": "node scripts/audit-bundle-hosts.mjs",
    "test:smoke:portfolio-screenshots": "EXTENSION_TYPE=chrome VUE_APP_TEST_ONLY=true VUE_APP_EXTENSION_SMOKE=true OUTPUT_DIR=chrome-test IS_EXTENSION=true env-cmd -f .env.extension node scripts/build-extension.mjs --mode development && node scripts/solana-extension-smoke.mjs --portfolio-screenshots",
    "audit:portfolio-dashboard-absent": "node scripts/check-portfolio-dashboard-absent.mjs dist/extension/chrome",
    "audit:chrome-release": "node scripts/audit-chrome-release.mjs",
    "audit:chrome-release:artifact": "node scripts/audit-chrome-release.mjs --release",
    "audit:chrome-release:source": "node scripts/audit-release-source.mjs",
    "audit:chrome-release:release": "yarn audit:chrome-release:source && yarn audit:chrome-release:artifact",
    "audit:vendored-iroha-sdk": "node scripts/audit-vendored-iroha-js-sdk.mjs",
    "import:chrome-release-config": "node scripts/import-chrome-release-config.mjs",
    "prepare:chrome-release": "node scripts/prepare-chrome-release.mjs",
    "test:bundle-host-audit": "node scripts/test-bundle-host-audit.mjs",
    "test:chrome-release-audit": "node scripts/test-chrome-release-audit.mjs",
    "test:extension-package": "node scripts/test-package-extension.mjs",
    "verified:crx": "node scripts/verified-crx.mjs",
    "test:verified-crx": "node --test scripts/test-verified-crx.mjs",
    "test:extension-build-environment": "node scripts/test-extension-build-environment.mjs",
    "test:import-chrome-release-config": "node scripts/test-import-chrome-release-config.mjs",
    "test:prepare-chrome-release": "node scripts/test-prepare-chrome-release.mjs",
    "test:release-source-audit": "node scripts/test-release-source-audit.mjs",
    "test:vendored-iroha-sdk-audit": "node scripts/test-vendored-iroha-js-sdk-audit.mjs",
    "audit:package-manager": "node scripts/audit-package-manager.mjs",
    "test:package-manager-audit": "node scripts/test-package-manager-audit.mjs",
    "audit:github-actions": "node scripts/audit-github-actions.mjs",
    "test:github-actions-audit": "node scripts/test-github-actions-audit.mjs",
    "test:smoke:firefox": "yarn test:firefox-smoke-policy && node scripts/firefox-extension-smoke.mjs",
    "test:smoke:bitcoin": "vitest run tests/smoke/bitcoin-testnet-broadcast.spec.ts",
    "test:smoke:taira": "vitest run tests/smoke/iroha-taira-transfer.spec.ts",
    "generate:bitcoin-broadcast-evidence-template": "bash scripts/generate-bitcoin-broadcast-evidence-template.sh",
    "audit:bitcoin-broadcast-evidence": "bash scripts/audit-bitcoin-broadcast-evidence.sh",
    "test:bitcoin-broadcast-evidence-audit": "bash scripts/test-bitcoin-broadcast-evidence-audit.sh",
    "test:bitcoin-broadcast-evidence-template": "bash scripts/test-bitcoin-broadcast-evidence-template.sh",
    "test:crypto-dependency-shims": "node scripts/test-crypto-dependency-shims.mjs",
    "test:development-dependency-guards": "node scripts/test-development-dependency-guards.mjs",
    "test:iroha-safari-qa": "bash scripts/test-iroha-js-candidate-safari-qa.sh",
    "qa:iroha-safari": "bash scripts/run-iroha-js-candidate-safari-qa.sh",
    "test:all": "yarn typecheck && yarn lint:check && yarn test:unit",
    "audit:sora-removal": "node scripts/audit-sora-dependency-removal.mjs",
    "test:sora-removal": "node --test scripts/test-sora-dependency-removal.mjs"
  },
