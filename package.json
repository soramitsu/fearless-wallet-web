    "rlp": "^3.0.0",
    "rxjs": "^7.5.6",
    "svg-sprite-loader": "^6.0.11",
    "tippy.js": "^6.3.7",
    "tonweb-mnemonic": "1.0.1",
    "uuidv4": "^6.2.13",
    "vue": "^3.5.22",
    "vue-i18n": "^9.9.0",
    "vue-plugin-load-script": "2.1.1",
