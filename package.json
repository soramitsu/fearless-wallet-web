{
  "name": "fearless-wallet",
  "version": "3.0.3",
  "private": true,
  "author": {
    "email": "fearless.web@soramitsu.co.jp",
    "name": "Soramitsu",
    "url": "https://soramitsu.co.jp"
  },
  "description": "Non-Custodial and Decentralized wallet for the Polkadot, Ethereum and TON ecosystems with the best UX, performance and security.",
  "browserslist": "last 2 Chrome versions, last 2 Firefox versions",
  "scripts": {
    "serve": "env-cmd -f .env.web vue-cli-service serve",
    "test:unit": "BROWSERSLIST_IGNORE_OLD_DATA=1 TS_JEST_DISABLE_VER_CHECKER=true vue-cli-service test:unit --coverage",
    "lint": "eslint --fix 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "lint:ci": "eslint 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-watch:extension": "EXTENSION_TYPE=chrome OUTPUT_DIR=chrome env-cmd -f .env.extension  vue-cli-service  --env.NODE_ENV=development build-watch --mode development",
    "build-watch:extension:firefox": "EXTENSION_TYPE=firefox OUTPUT_DIR=firefox env-cmd -f .env.extension vue-cli-service  --env.NODE_ENV=development build-watch --mode development",
    "build:extension": "yarn lint:ci && EXTENSION_TYPE=chrome OUTPUT_DIR=chrome env-cmd -f .env.extension vue-cli-service --env.NODE_ENV=production build",
    "build:extension-test": "yarn lint:ci && EXTENSION_TYPE=chrome VUE_APP_TEST_ONLY=true OUTPUT_DIR=chrome-test env-cmd -f .env.extension vue-cli-service --env.NODE_ENV=development build --mode development",
    "build:extension-test:zip": "yarn run build:extension-test && cd dist/extension/chrome-test && zip -r fearless-wallet-extension-chrome-test.zip . && cd ../../../",
    "build:extension:all": "yarn build:extension:zip && yarn build:extension-test:zip && yarn build:extension:firefox:zip",
    "build:extension:firefox": "yarn lint:ci && EXTENSION_TYPE=firefox OUTPUT_DIR=firefox env-cmd -f .env.extension vue-cli-service --env.NODE_ENV=production build",
    "build:extension:firefox-test": "yarn lint:ci && EXTENSION_TYPE=firefox VUE_APP_TEST_ONLY=true OUTPUT_DIR=firefox-test env-cmd -f .env.extension vue-cli-service --env.NODE_ENV=development build --mode development",
    "build:extension:firefox:zip": "yarn run build:extension:firefox && cd dist/extension/firefox && zip -r fearless-wallet-extension-firefox.zip . && cd ../../../",
    "build:extension:zip": "yarn run build:extension && cd dist/extension/chrome && zip -r fearless-wallet-extension-chrome.zip . && cd ../../../",
    "build:web": "env-cmd -f .env.web vue-cli-service --env.NODE_ENV=production build",
    "lint:precommit": "NODE_ENV=production eslint --fix --quiet 'src/**/*.{js,jsx,vue,ts,tsx}'",
    "test:all": "yarn test:unit --coverage"
  },
  "main": "index.js",
  "dependencies": {
    "@json-rpc-tools/utils": "^1.7.6",
    "@metamask/safe-event-emitter": "^3.0.0",
    "@open-web3/orml-api-derive": "^2.0.1",
    "@open-web3/orml-type-definitions": "^2.0.1",
    "@orbs-network/ton-access": "^2.3.3",
    "@polkadot/api": "^16.4.9",
    "@polkadot/extension-chains": "^0.62.3",
    "@polkadot/extension-dapp": "^0.62.3",
    "@polkadot/extension-inject": "^0.62.3",
    "@polkadot/networks": "^13.5.7",
