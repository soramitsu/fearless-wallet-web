    "@walletconnect/types": "^2.22.4",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "css-unicode-loader": "^1.0.3",
    "env-cmd": "^11.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^10.5.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.6",
    "network-information-types": "^0.1.1",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.6",
    "serviceworker-webpack-plugin": "^1.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "vue-cli-plugin-chrome-extension-cli": "^1.1.4",
    "vue-eslint-parser": "^9.4.2",
    "webpack": "^5.96.1",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "resolutions": {
    "axios": "^0.27.2",
    "@polkadot/api": "16.4.9",
    "@polkadot/types": "16.4.9",
    "@polkadot/rpc-provider": "16.4.9",
    "@polkadot/networks": "13.5.7",
    "@polkadot/util": "13.5.7",
    "@polkadot/util-crypto": "13.5.7",
    "@polkadot/x-fetch": "13.5.7"
  },
  "license": "Apache-2.0",
  "packageManager": "yarn@3.4.1",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "prettier --write",
      "yarn lint:precommit"
    ],
    "*.{json,md,scss,css,yaml,yml}": "prettier --write"
  },
  "_pathAliases": {
    "@polkadot/*": "node_modules/@polkadot/*"
  }
}
