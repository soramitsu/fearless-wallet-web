{
  "name": "fearless-wallet-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "env-cmd -f .env.desktop vue-cli-service serve",
    "build": "env-cmd -f .env.desktop vue-cli-service build",
    "build:extension": "env-cmd -f .env.extension vue-cli-service build --progress",
    "build-watch:extension": "env-cmd -f .env.extension vue-cli-service  --env.NODE_ENV=development build-watch --mode development",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint --fix",
    "electron:build": "env-cmd -f .env.desktop vue-cli-service electron:build",
    "electron:serve": "env-cmd -f .env.desktop vue-cli-service electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test:all": "yarn test:unit",
    "audit:desktop": "npx electronegativity -i ./ -x LimitNavigationGlobalCheck,PermissionRequestHandlerGlobalCheck"
  },
  "main": "index.js",
  "dependencies": {
    "@airgap/beacon-sdk": "^3.3.0",
    "@equilab/api": "^1.13.1",
    "@polkadot/api": "^9.2.3",
    "@polkadot/extension-chains": "^0.44.6",
    "@polkadot/extension-dapp": "^0.44.6",
    "@polkadot/extension-inject": "^0.44.6",
    "@polkadot/phishing": "^0.18.9",
    "@polkadot/ui-keyring": "^2.9.6",
    "@polkadot/vue-identicon": "^2.9.8",
    "@soramitsu/soramitsu-js-ui": "^1.0.26",
    "axios": "^0.27.2",
    "bignumber.js": "^9.0.2",
    "core-js": "^3.6.5",
    "date-fns": "^2.28.0",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "qrcode": "^1.5.1",
    "rxjs": "^7.5.6",
    "svg-sprite-loader": "^6.0.11",
    "tippy.js": "^6.3.7",
    "vue": "^2.6.14",
    "vue-class-component": "^7.2.6",
    "vue-fragment": "^1.6.0",
    "vue-i18n": "8",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.2.0",
    "vuedraggable": "^2.24.3",
    "vuex": "^3.4.0",
    "vuex-class": "^0.3.2"
  },
  "devDependencies": {
    "@doyensec/electronegativity": "^1.9.1",
    "@open-web3/orml-types": "^1.0.1",
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/chrome": "^0.0.179",
    "@types/electron-devtools-installer": "^2.2.2",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^26.0.19",
    "@types/lodash": "^4.14.174",
    "@types/node": "^16.11.6",
    "@types/qrcode": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-e2e-cypress": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-unit-jest": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-standard": "^6.1.0",
    "@vue/eslint-config-typescript": "^8.0.0",
    "@vue/test-utils": "^1.2.2",
    "@vue/vue2-jest": "^27.0.0-alpha.3",
    "css-unicode-loader": "^1.0.3",
    "cypress": "^9.7.0",
    "electron": "^19.0.10",
    "electron-builder": "23.0.2",
    "electron-devtools-installer": "^3.2.0",
    "env-cmd": "^10.1.0",
    "eslint": "^7.29.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^5.1.1",
    "eslint-plugin-vue": "^7.20.0",
    "jest": "^27.2.2",
    "lint-staged": "^9.5.0",
    "node-polyfill-webpack-plugin": "^1.1.4",
    "node-sass": "^4.12.0",
    "prettier": "^2.2.1",
    "sass-loader": "^12.3.0",
    "ts-jest": "^27.0.5",
    "typescript": "~4.5.5",
    "vue-cli-plugin-chrome-extension-cli": "^1.1.4",
    "vue-cli-plugin-electron-builder": "^3.0.0-alpha.4",
    "vue-template-compiler": "2.6.14"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint --fix",
      "git add"
    ]
  }
}
