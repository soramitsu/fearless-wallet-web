{
  "homepage_url": "https://fearlesswallet.io/",
  "name": "Fearless Wallet",
  "short_name": "FW",
  "author": "Soramitsu",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "identity", "clipboardRead"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Fearless Wallet",
    "default_popup": "popup.html"
  },
  "host_permissions": ["<all_urls>"],
  "oauth2": {
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "minimum_chrome_version": "92",
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://*/*", "http://*/*"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://*/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self';  style-src 'unsafe-inline';img-src 'self' https://raw.githubusercontent.com  https://icons.duckduckgo.com/ data:; frame-src https://soracard.com/; connect-src https: wss: ws:"
  }
}
