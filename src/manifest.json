{
  "author": "Soramitru",
  "name": "Fearless Wallet Web",
  "short_name": "FWW",
  "description": "Extension for working with Polkadot networks. Manage your Polkadot accounts outside of dapps.",
  "homepage_url": "https://github.com/soramitsu/fearless-wallet-web",
  "version": "0.0.1",
  "default_locale": "en",
  "manifest_version": 3,
  "background": {
    "service_worker": "js/serviceWorker.js"
  },
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "action": {
    "default_title": "Fearless Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/get_started16.png",
      "32": "icons/get_started32.png",
      "48": "icons/get_started48.png",
      "128": "icons/get_started128.png"
    }
  },
  "content_scripts": [{
    "js": ["js/content.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "icons": {
    "16": "icons/get_started16.png",
    "32": "icons/get_started32.png",
    "48": "icons/get_started48.png",
    "128": "icons/get_started128.png"
  }
}