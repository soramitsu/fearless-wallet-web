{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "moduleDetection": "force",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["webpack-env", "jest", "node", "chrome", "firefox-webext-browser", "network-information-types"],
    "paths": {
      "@/*": ["src/*"],
      "@extension-base/*": ["src/extension/background/extension-base/src/*"],
      "@sora": ["src/sora/index.ts"],
      "@sora/*": ["src/sora/*"],
      "@sora-typeDefs": ["src/sora/typeDefinitions"],
      "@sora-types/*": ["src/types/sora.ts"],
      "@sora-types": ["src/types/sora.ts"],
      "@sora-substrate/util/src/bridgeProxy/sub/consts": ["tests/unit/__mocks__/soraSubBridgeConsts.ts"],
      "@polkadot/*": ["node_modules/@polkadot/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  },
  "vueCompilerOptions": {
    "target": 3
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.d.ts",
    "src/extension/makeManifest.js"
  ],
  "exclude": ["node_modules"]
}
